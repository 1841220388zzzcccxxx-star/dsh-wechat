{
  "name": "@xmanrui/dsh-weixin",
  "version": "0.1.1",
  "description": "DeepSeek Harness Weixin channel plugin with QR-code account binding",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1841220388zzzcccxxx-star/dsh-wechat.git"
  },
  "homepage": "https://github.com/1841220388zzzcccxxx-star/dsh-wechat#readme",
  "bugs": "https://github.com/1841220388zzzcccxxx-star/dsh-wechat/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-weixin": "./bin/dsh-weixin.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cordis.patch.yml",
    "lib",
    "plugin-src",
    "scripts",
    "src",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build && node scripts/verify-package.mjs",
    "verify:protocol": "node scripts/verify-protocol.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
